# Copy to apps/web/.env.local for local overrides.
# Only VITE_* variables are embedded in the browser bundle. Never put secrets in them.

# Leave unset to use "/api" (dev proxy or same-site production).
# VITE_API_BASE_URL=https://api.example.com/api

# Dev-server only (read by vite.config.ts, not shipped to the browser)
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:4000

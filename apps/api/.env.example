# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# SQLite database file, created by `npm run setup` (relative to apps/api)
DATABASE_URL=file:./dev.db

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=604800
# COOKIE_DOMAIN=.example.com

CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
